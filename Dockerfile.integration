# Dockerfile for running tests
FROM golang:1.23-alpine

# Install necessary tools
RUN apk add --no-cache \
    git \
    make \
    postgresql-client \
    gcc \
    musl-dev

# Set working directory
WORKDIR /workspace

# Copy go mod files
COPY outbox_uow_abstraction/go.mod outbox_uow_abstraction/go.sum ./outbox_uow_abstraction/
COPY outbox_uow_pgsql/go.mod outbox_uow_pgsql/go.sum ./outbox_uow_pgsql/

# Download dependencies
RUN cd outbox_uow_abstraction && go mod download
RUN cd outbox_uow_pgsql && GOINSECURE="proxy.golang.org" go mod download

# Copy source code
COPY . .

# Set environment variables
ENV CGO_ENABLED=1
ENV GOOS=linux

CMD ["make", "test-all"]

